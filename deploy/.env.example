# Copy to deploy/.env and adjust as needed for local development.
# `docker compose -f deploy/docker-compose.dev.yml --env-file deploy/.env up --build`

# Superuser for the Postgres container. The per-service databases and roles
# (auth_svc/auth_db, kitty_svc/kitty_db) are created by postgres/init.sql.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
